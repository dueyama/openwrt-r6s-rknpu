    "NanoPi R6S", "FriendlyElec", "Rockchip", "RK3588S", "RKNPU",
    "NPU", "OpenWrt", "Linux 6.12", "AArch64", "device tree", "IOMMU",
    "router", "edge inference", "Kitsune", "KitNET", "network anomaly detection",
    "FP16", "sigmoid", "lookup table", "numerical reproducibility"
  ],
