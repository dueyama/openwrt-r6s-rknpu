+/* This port only accepts the sealed R6S RK3588 three-domain topology.
+ * Validate before allocation, mapping registers, or enabling runtime PM. */
+static int r6s_rk3588_power_domains(struct device *dev,
+                                   const struct rknpu_config *config)
+{
+ const char *names[] = { "npu0", "npu1", "npu2" };
+ const u32 ids[] = { RK3588_PD_NPUTOP, RK3588_PD_NPU1, RK3588_PD_NPU2 };
+ struct device_node *provider = NULL;
+ struct of_phandle_args args;
+ const char *name;
+ int i, ret;
+
+ if (!of_machine_is_compatible("friendlyarm,nanopi-r6s") ||
+     !of_device_is_compatible(dev->of_node, "rockchip,rk3588-rknpu") ||
+     config != &rk3588_rknpu_config || config->num_irqs != 3 ||
+     config->core_mask != 0x7)
+  return -EOPNOTSUPP;
+ ret = of_count_phandle_with_args(dev->of_node, "power-domains",
+                                 "#power-domain-cells");
+ if (ret < 0) return ret;
+ if (ret != 3 || of_property_count_strings(dev->of_node,
+                                          "power-domain-names") != 3)
+  return -EINVAL;
+ for (i = 0; i < 3; i++) {
+  ret = of_property_read_string_index(dev->of_node, "power-domain-names",
+                                      i, &name);
+  if (ret || strcmp(name, names[i])) { ret = ret ? ret : -EINVAL; goto out; }
+  ret = of_parse_phandle_with_args(dev->of_node, "power-domains",
+                                   "#power-domain-cells", i, &args);
+  if (ret) goto out;
+  if (args.args_count != 1 || args.args[0] != ids[i] ||
+      !of_device_is_compatible(args.np, "rockchip,rk3588-power-controller") ||
+      (provider && provider != args.np)) {
+   of_node_put(args.np); ret = -EINVAL; goto out;
+  }
+  if (!provider) provider = of_node_get(args.np);
+  of_node_put(args.np);
+ }
+ ret = 0;
+out:
+ of_node_put(provider);
+ return ret;
+}
