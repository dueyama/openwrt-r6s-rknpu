+static ssize_t r6s_npu_load_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct rknpu_device *npu = dev_get_drvdata(dev);
+	struct r6s_busy_counter counters[3];
+	u64 now, busy[3];
+	unsigned long flags;
+	int i, len;
+	if (!npu || !npu->rk3588_core0_banks) return -ENODATA;
+	spin_lock_irqsave(&npu->irq_lock, flags);
+	now = ktime_get_ns();
+	for (i=0; i<npu->config->num_irqs; i++) {
+		counters[i] = npu->r6s_busy[i];
+		busy[i] = r6s_busy_read(&counters[i], now);
+	}
+	spin_unlock_irqrestore(&npu->irq_lock, flags);
+	len = sysfs_emit(buf, "schema=1 epoch_ns=%llu monotonic_ns=%llu cores=%d metric=job_interval_ns\n",
+		(unsigned long long)npu->r6s_load_epoch_ns, (unsigned long long)now, npu->config->num_irqs);
+	for (i=0; i<npu->config->num_irqs; i++)
+		len += sysfs_emit_at(buf, len, "core=%d busy_ns=%llu active=%u starts=%llu finishes=%llu aborts=%llu\n",
+			i, (unsigned long long)busy[i], counters[i].active,
+			(unsigned long long)counters[i].starts, (unsigned long long)counters[i].finishes,
+			(unsigned long long)counters[i].aborts);
+	return len;
+}
