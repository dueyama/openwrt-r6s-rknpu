+static int rknpu_power_on(struct rknpu_device *npu)
+{
+ int ret;
+ /* Mainline IOMMU PM device-links order the NPUTOP supplier. No BSP
+  * private IOMMU-layout or fake paging-enabled checks are used. */
+ if (!npu->vdd)
+  return -EOPNOTSUPP;
+ ret = regulator_enable(npu->vdd);
+ if (ret) return ret;
+ if (npu->mem) {
+  ret = regulator_enable(npu->mem);
+  if (ret) goto vdd_off;
+ }
+ ret = clk_bulk_prepare_enable(npu->num_clks, npu->clks);
+ if (ret) goto mem_off;
+ ret = pm_runtime_resume_and_get(npu->dev);
+ if (ret < 0) goto clocks_off;
+ return 0;
+clocks_off:
+ clk_bulk_disable_unprepare(npu->num_clks, npu->clks);
+mem_off:
+ if (npu->mem) regulator_disable(npu->mem);
+vdd_off:
+ regulator_disable(npu->vdd);
+ return ret;
+}
+
+static int rknpu_power_off(struct rknpu_device *npu)
+{
+ int ret;
+
+ ret = pm_runtime_put_sync_suspend(npu->dev);
+ if (ret < 0) {
+  pm_runtime_resume_and_get(npu->dev);
+  return ret;
+ }
+ clk_bulk_disable_unprepare(npu->num_clks, npu->clks);
+ if (npu->mem) regulator_disable(npu->mem);
+ regulator_disable(npu->vdd);
+ return 0;
 }
 
