--- /dev/null
+++ b/rknpu_mainline_devfreq.c
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-2.0
+/* R6S Linux 6.12 port; modified 2026-10-11. See docs/PORTING.md. */
+/* R6S initial mainline port: real regulator/clock OPP, fixed 200MHz. */
+#include <linux/clk.h>
+#include <linux/devfreq.h>
+#include <linux/pm_opp.h>
+#include <linux/regulator/consumer.h>
+#include "rknpu_drv.h"
+#include "rknpu_devfreq.h"
+#define R6S_NPU_RATE 200000000UL
+static int target(struct device *dev, unsigned long *freq, u32 flags)
+{
+ struct rknpu_device *npu = dev_get_drvdata(dev);
+ int ret;
+ if (*freq != R6S_NPU_RATE) return -EOPNOTSUPP;
+ mutex_lock(&npu->frequency_lock);
+ ret = dev_pm_opp_set_rate(dev, R6S_NPU_RATE);
+ if (!ret) {
+  npu->current_freq = clk_get_rate(npu->clks[0].clk);
+  npu->current_volt = regulator_get_voltage(npu->vdd);
+ }
+ mutex_unlock(&npu->frequency_lock);
+ return ret;
+}
+static int current_rate(struct device *dev, unsigned long *freq)
+{
+ struct rknpu_device *npu = dev_get_drvdata(dev);
+ *freq = clk_get_rate(npu->clks[0].clk);
+ return 0;
+}
+static struct devfreq_dev_profile profile = {
+ .initial_freq = R6S_NPU_RATE, .polling_ms = 0,
+ .target = target, .get_cur_freq = current_rate,
+};
+void rknpu_devfreq_lock(struct rknpu_device *npu)
+{ mutex_lock(&npu->frequency_lock); }
+void rknpu_devfreq_unlock(struct rknpu_device *npu)
+{ mutex_unlock(&npu->frequency_lock); }
+int rknpu_devfreq_init(struct rknpu_device *npu)
+{
+ const char *clocks[] = { "clk_npu", NULL };
+ const char *regulators[] = { "rknpu", NULL };
+ struct dev_pm_opp_config config = { .clk_names = clocks,
+                                     .regulator_names = regulators };
+ struct dev_pm_opp *opp;
+ unsigned long freq = R6S_NPU_RATE;
+ int ret;
+ npu->opp_config_token = dev_pm_opp_set_config(npu->dev, &config);
+ if (npu->opp_config_token < 0) return npu->opp_config_token;
+ ret = dev_pm_opp_of_add_table(npu->dev);
+ if (ret) goto clear;
+ npu->opp_table_added = true;
+ opp = dev_pm_opp_find_freq_exact(npu->dev, freq, true);
+ if (IS_ERR(opp)) { ret = PTR_ERR(opp); goto table; }
+ dev_pm_opp_put(opp);
+ ret = target(npu->dev, &freq, 0);
+ if (ret) goto table;
+ npu->devfreq = devfreq_add_device(npu->dev, &profile,
+                                  DEVFREQ_GOV_USERSPACE, NULL);
+ if (IS_ERR(npu->devfreq)) {
+  ret = PTR_ERR(npu->devfreq); npu->devfreq = NULL; goto table;
+ }
+ return 0;
+table:
+ dev_pm_opp_of_remove_table(npu->dev); npu->opp_table_added = false;
+clear:
+ dev_pm_opp_clear_config(npu->opp_config_token);
+ return ret;
+}
+void rknpu_devfreq_remove(struct rknpu_device *npu)
+{
+ if (npu->devfreq) { devfreq_remove_device(npu->devfreq); npu->devfreq = NULL; }
+ if (npu->opp_table_added) {
+  dev_pm_opp_of_remove_table(npu->dev); npu->opp_table_added = false;
+  dev_pm_opp_clear_config(npu->opp_config_token);
+ }
+}
+int rknpu_devfreq_runtime_suspend(struct device *dev)
+{
+ struct rknpu_device *npu = dev_get_drvdata(dev);
+ return npu->devfreq ? devfreq_suspend_device(npu->devfreq) : 0;
+}
+int rknpu_devfreq_runtime_resume(struct device *dev)
+{
+ struct rknpu_device *npu = dev_get_drvdata(dev);
+ return npu->devfreq ? devfreq_resume_device(npu->devfreq) : 0;
+}
--- /dev/null
+++ b/rknpu_mainline_iommu.c
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0
+/* R6S Linux 6.12 port; modified 2026-10-11. See docs/PORTING.md. */
+/* R6S Linux 6.12 port: public DMA/IOMMU APIs only. */
+#include <linux/dma-mapping.h>
+#include <linux/iommu.h>
+#include <linux/dev_printk.h>
+#include "rknpu_iommu.h"
+int rknpu_iommu_dma_map_sg(struct device *dev, struct scatterlist *sg,
+ int nents, enum dma_data_direction dir, bool iova_aligned)
+{
+ struct scatterlist *entry;
+ dma_addr_t next = 0;
+ int mapped, i, seen = 0;
+ mapped = dma_map_sg(dev, sg, nents, dir);
+ if (!mapped) return 0;
+ /* Vendor command buffers require a contiguous device-address range.
+  * The kernel DMA mapper owns allocation/unmapping; never cast its cookie. */
+ for_each_sg(sg, entry, mapped, i) {
+  if (!sg_dma_len(entry)) continue;
+  if (seen && sg_dma_address(entry) != next) goto reject;
+  next = sg_dma_address(entry) + sg_dma_len(entry);
+  if (next < sg_dma_address(entry)) goto reject;
+  seen++;
+ }
+ if (seen != mapped) goto reject;
+ return mapped;
+reject:
+ dma_unmap_sg(dev, sg, nents, dir);
+ return 0;
+}
+void rknpu_iommu_dma_unmap_sg(struct device *dev, struct scatterlist *sg,
+ int nents, enum dma_data_direction dir, bool iova_aligned)
+{
+ dma_unmap_sg(dev, sg, nents, dir);
+}
+int rknpu_iommu_init_domain(struct rknpu_device *npu)
+{
+ struct iommu_domain *domain = iommu_get_domain_for_dev(npu->dev);
+ if (!npu->iommu_en || !domain) return -ENODEV;
+ if (!(domain->type & __IOMMU_DOMAIN_DMA_API))
+  return dev_err_probe(npu->dev, -EOPNOTSUPP,
+                       "translated DMA domain required; current type=%u\n",
+                       domain->type);
+ npu->iommu_domains[0] = domain;
+ npu->iommu_domain_id = 0;
+ npu->iommu_domain_num = 1;
+ return 0;
+}
+int rknpu_iommu_switch_domain(struct rknpu_device *npu, int id)
+{
+ if (id != 0) return -EOPNOTSUPP;
+ if (iommu_get_domain_for_dev(npu->dev) != npu->iommu_domains[0])
+  return -ENODEV;
+ return 0;
+}
+int rknpu_iommu_domain_get_and_switch(struct rknpu_device *npu, int id)
+{
+ int ret;
+ mutex_lock(&npu->domain_lock);
+ ret = rknpu_iommu_switch_domain(npu, id);
+ if (!ret) atomic_inc(&npu->iommu_domain_refcount);
+ mutex_unlock(&npu->domain_lock);
+ return ret;
+}
+int rknpu_iommu_domain_put(struct rknpu_device *npu)
+{
+ if (WARN_ON_ONCE(atomic_dec_return(&npu->iommu_domain_refcount) < 0))
+  return -EINVAL;
+ return 0;
+}
+void rknpu_iommu_free_domains(struct rknpu_device *npu)
+{
+ /* Domain 0 belongs to the IOMMU core, not this driver. */
+ WARN_ON_ONCE(atomic_read(&npu->iommu_domain_refcount));
+ npu->iommu_domains[0] = NULL;
+ npu->iommu_domain_num = 0;
+}
